<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Digital Grimoire</title>
</head>
<body>
<div class="board">
<h1 class="cursor">digital_grimoire.log</h1>
  <p class="subtitle">// inscribed entries, most recent first</p>
  <hr class="divider">

  <% messages.forEach(({ id, text, user, added }) => { %>
    <div class="message-card">
      <p><span class="label">user:</span> <span class="value"><%= user %></span></p>
      <p><span class="label">msg:</span> <span class="value"><%= text %></span></p>
      <p><span class="label">timestamp:</span> <span class="value"><%= added %></span></p>
      <a class="expand" href="/details/<%= id %>">cat entry_<%= id %>.log ></a>
    </div>
  <% }) %>

  <a class="new-message-link" href="/new">$ inscribe new entry</a>
</div>
</body>
</html>


