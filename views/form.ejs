<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css" />
    <title>New entry — Digital Grimoire</title>
  </head>
  <body>
    <div class="form-wrap">
      <h1>new_entry.write()</h1>
      <p class="subtitle">// fill the runes below to inscribe your message</p>

      <form action="/new" method="post">
        <label for="author">$ signed_by</label>
        <input
          type="text"
          name="author"
          id="author"
          placeholder="your name"
          value="<%= locals.author || '' %>"
        />
        <% if (locals.errors) { %>
          <% errors.filter(e => e.path === "author").forEach(function(error) { %>
            <p class="field-error"><%= error.msg %></p>
          <% }); %>
        <% } %>

        <label for="message">$ message_body</label>
        <textarea
          name="message"
          id="message"
          placeholder="type your incantation..."
        ><%= locals.message || '' %></textarea>
        <% if (locals.errors) { %>
          <% errors.filter(e => e.path === "message").forEach(function(error) { %>
            <p class="field-error"><%= error.msg %></p>
          <% }); %>
        <% } %>

        <button type="submit">inscribe →</button>
      </form>
      <a class="nav-link" href="/">&lt; cd ..</a>
    </div>
  </body>
</html>