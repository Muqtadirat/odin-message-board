<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg">
    <link rel="stylesheet" href="/styles.css" />
    <title>entry_<%= id %>.log</title>
  </head>
  <body>
    <div class="details-wrap">
      <h1 class="cursor">entry_<%= id %>.log</h1>
      <p class="subtitle">// full record</p>
      <p><span class="label">id:</span> <%= id %></p>
      <p><span class="label">user:</span> <%= user %></p>
      <p><span class="label">msg:</span> <%= text %></p>
      <p><span class="label">timestamp:</span> <%= added %></p>
      <a class="nav-link" href="/">&lt; cd ..</a>
    </div>
  </body>
</html>

